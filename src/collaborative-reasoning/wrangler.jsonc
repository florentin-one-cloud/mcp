{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "collaborative-reasoning",
  "main": "dist/worker.js",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "cache": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "collaborative-reasoning.florentin.dev",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["POSTHOG_API_KEY"]
  }
}
