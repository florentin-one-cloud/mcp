{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "dist/worker.js",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "cache": {
    "enabled": true
  },
  "secrets_store_secrets": [
    {
      "binding": "posthog-project-token_mcp",
      "store_id": "a5c78b7b903940898c0880c4cced17d2",
      "secret_name": "POSTHOG_PROJECT_TOKEN"
    }
  ],
  "name": "collaborative-reasoning",
  "routes": [
    {
      "pattern": "collaborative-reasoning.florentin.dev",
      "custom_domain": true
    }
  ]
}
