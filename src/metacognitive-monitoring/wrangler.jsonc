{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "metacognitive-monitoring",
  "main": "dist/worker.js",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "metacognitive-monitoring.florentin.dev",
      "custom_domain": true
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "POSTHOG_API_KEY",
      "store_id": "a5c78b7b903940898c0880c4cced17d2",
      "secret_name": "internal-mcp-POSTHOG_API_KEY"
    }
  ]
}
