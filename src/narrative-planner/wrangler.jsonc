{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "dist/worker.js",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "cache": {
    "enabled": true
  },
  "name": "narrative-planner",
  "routes": [
    {
      "pattern": "narrative-planner.florentin.dev",
      "custom_domain": true
    }
  ]
}
