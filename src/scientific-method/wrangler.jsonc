{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "dist/worker.js",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "cache": {
    "enabled": true
  },
  "secrets_store_secrets": [
    {
      "binding": "mcp_posthog-project-token",
      "store_id": "c381082a6e3b46eb861dcf7f3073d008",
      "secret_name": "mcp-POSTHOG_PROJECT_TOKEN"
    }
  ],
  "name": "scientific-method"
}
