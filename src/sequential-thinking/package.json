{
  "name": "@florentin-one/mcp-sequential-thinking",
  "version": "0.4.13",
  "description": "MCP server for sequential thinking and problem solving",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florentin-one-cloud/mcp.git",
    "directory": "src/sequential-thinking"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "bugs": {
    "url": "https://github.com/florentin-one-cloud/mcp/issues"
  },
  "homepage": "https://github.com/florentin-one-cloud/mcp/tree/main/src/sequential-thinking",
  "author": "Phichayut 'Florentin' Sakwiset (https://github.com/heyFlorentin)",
  "keywords": [
    "sequential-thinking"
  ],
  "bin": {
    "mcp-server-sequential-thinking": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir='./dist' --target='bun' && bun build ./src/worker.ts --outfile='./dist/worker.js' --target='node' --format='esm' && tsc",
    "start": "bun run ./dist/index.js",
    "test": "bun test",
    "deploy": "bunx wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.3.3",
    "wrangler": "^4.115.0"
  }
}
