{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "constraint-solver",
  "main": "dist/worker.js",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "constraint-solver.florentin.dev",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["POSTHOG_API_KEY"]
  }
}
