{
  "name": "mcp",
  "author": "Florentin One (https://florentin.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florentin-one/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/florentin-one/mcp/issues"
  },
  "description": "WeMake Model Context Protocol (MCP) servers",
  "homepage": "https://wemake.cx",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "src/*"
  ],
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.0",
  "scripts": {
    "build-all": "bun run --filter='./src/*' build",
    "test": "bun test",
    "test:all": "bun run --filter='./src/*' test",
    "test:coverage": "bun test --coverage",
    "test:coverage:all": "bun run --filter='./src/*' test --coverage",
    "link-all": "bun link --workspaces",
    "format": "prettier --write . && eslint . --ext .ts,.tsx --fix",
    "check": "tsc --noEmit",
    "publish-packages": "bun run --filter='./src/*' publish",
    "publish-changed": "bun run --filter='./src/*' publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "posthog-node": "^5.46.1"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.2.21",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "eslint": "9.37.0",
    "globals": "15.15.0",
    "markdownlint": "0.38.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "wrangler": "^4.114.0"
  },
  "prettier": {
    "trailingComma": "none",
    "printWidth": 120,
    "proseWrap": "always",
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          ".github/workflows/*.yml"
        ],
        "options": {
          "proseWrap": "never",
          "objectWrap": "collapse"
        }
      }
    ]
  }
}
